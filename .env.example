# Environment Variables Configuration
# Copy this file to .env and update with your values

# Session Secret (REQUIRED for production)
# Generate a secure random string: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Server Port (optional, defaults to 3000)
PORT=3000

# Node Environment (development or production)
NODE_ENV=development

# Metadata and External Integrations
SITE_URL=https://www.waleedarafat.org
FB_APP_ID=

# Optional storage overrides (recommended in cloud with persistent disk)
# DATA_DIR=/var/data/app-data
# UPLOADS_DIR=/var/data/app-uploads
# BACKUPS_DIR=/var/data/app-backups

# Bootstrap admin user when users.json does not exist
# REQUIRED when users.json is empty/missing
# Credentials must be configured via environment variables.
# ADMIN_BOOTSTRAP_USERNAME=admin
# ADMIN_BOOTSTRAP_PASSWORD=
# ADMIN_BOOTSTRAP_EMAIL=

# Redis session configuration
# Prefer REDIS_URL when available
# REDIS_URL=redis://localhost:6379
# REDIS_HOST=127.0.0.1
# REDIS_PORT=6379
# REDIS_PASSWORD=

# ── Redis key isolation (IMPORTANT when sharing a Redis instance) ─────────────
#
# REDIS_PREFIX isolates all Redis keys for this service so that two services
# sharing the same Redis instance cannot read or overwrite each other's data.
#
# Set this to a unique value per deployment:
#   SATT service          → REDIS_PREFIX=satt_
#   Medical-Website       → REDIS_PREFIX=medical_
#
# The prefix is automatically prepended to every Redis key used by the app,
# including session keys (e.g. "satt_sess:<id>" vs "medical_sess:<id>").
# An error is thrown if code attempts to access a key without the correct
# prefix, preventing accidental cross-service data leakage.
#
# Default: "default_"  (safe for single-service deployments)
REDIS_PREFIX=default_

# SERVICE_NAME identifies which service is running.
# It is used to generate a unique session cookie name so that browsers do not
# send the wrong service's session cookie to the other service.
#
#   SATT service          → SERVICE_NAME=satt    (cookie: satt.sid)
#   Medical-Website       → SERVICE_NAME=medical (cookie: medical.sid)
#
# Default: "default"
SERVICE_NAME=default

# Session cookie lifetime in milliseconds (24h by default)
# SESSION_MAX_AGE_MS=86400000
