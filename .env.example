# Environment Variables Configuration
# Copy this file to .env and update with your values

# Session Secret (REQUIRED for production)
# Generate a secure random string: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Server Port (optional, defaults to 3000)
PORT=3000

# Node Environment (development or production)
NODE_ENV=development

# Metadata and External Integrations
SITE_URL=https://waleedarafat.org
FB_APP_ID=

# ========== VERCEL DEPLOYMENT ==========
# For Vercel, use external services instead of local filesystem

# PostgreSQL Database (Vercel Postgres or Supabase)
POSTGRES_URL=
POSTGRES_URL_NON_POOLING=

# Redis for Sessions (Upstash)
REDIS_URL=

# File Storage - AWS S3 OR Cloudinary
# Option A: AWS S3
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=

# Option B: Cloudinary (simpler)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ========== LOCAL RAILWAY DEPLOYMENT ==========
# Optional storage overrides (recommended in cloud with persistent disk)
# DATA_DIR=/var/data/app-data
# UPLOADS_DIR=/var/data/app-uploads
# BACKUPS_DIR=/var/data/app-backups

# Bootstrap admin user when users.json does not exist
# REQUIRED when users.json is empty/missing
# Credentials must be configured via environment variables.
# ADMIN_BOOTSTRAP_USERNAME=admin
# ADMIN_BOOTSTRAP_PASSWORD=
# ADMIN_BOOTSTRAP_EMAIL=

# Redis session configuration (for Railway/local)
# Prefer REDIS_URL when available
# REDIS_URL=redis://localhost:6379
# REDIS_HOST=127.0.0.1
# REDIS_PORT=6379
# REDIS_PASSWORD=

# Session cookie lifetime in milliseconds (24h by default)
# SESSION_MAX_AGE_MS=86400000
